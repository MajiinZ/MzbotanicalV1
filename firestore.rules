rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    // One verified Firebase Authentication email is authorized as owner.
    // Profile fields such as customer.isAdmin do not grant privileges.
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'zakfalkenbach92@gmail.com';
    }
    function verifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function validDisplayName(data) {
      return data.displayName is string && data.displayName.size() <= 50;
    }
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'email', 'createdAt'])
        && request.resource.data.keys().hasAll(['displayName'])
        && validDisplayName(request.resource.data);
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName'])
        && validDisplayName(request.resource.data);
      allow delete: if isAdmin();
    }
    // Retain the pre-existing plural collection for compatibility.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /orders/{orderId} {
      allow read: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }
    match /customer/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.id == uid
        && request.resource.data.get('isAdmin', false) == false;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName', 'lastName', 'city', 'postalCode', 'address',
          'phoneNumber', 'cart', 'profileImageUrl', 'dateOfBirth', 'gender'
        ]);
      allow delete: if isAdmin();
    }
    // The Android application uses this singular product collection.
    // Customer list queries must include where isPublished == true.
    match /product/{productId} {
      allow read: if isAdmin() || resource.data.get('isPublished', false) == true;
      allow write: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}